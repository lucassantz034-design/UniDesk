# Porta do Servidor Control Plane
PORT=4000

# Conexão com PostgreSQL (Obrigatório em produção: NODE_ENV=production)
DATABASE_URL=postgres://user:password@localhost:5432/unidesk_central
DB_SSL=false

# Integração Asaas API v3
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=$aact_example
ASAAS_WEBHOOK_SECRET=unidesk_secret_webhook_example

# Autenticação Master Admin (JWT HS256 e PBKDF2 Password Hashing)
JWT_SECRET=sua_chave_secreta_jwt_longa_e_aleatoria
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sua_senha_forte_master

# Chaves Criptográficas Ed25519 (Opcional se as chaves em backend/keys já existirem)
# ED25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# ED25519_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ==============================================================================
# UNIDESK — HELPDESK UNIVERSITÁRIO INTELIGENTE
# Configuração de Ambiente para Instalação do Cliente (On-Premise / Cloud)
# ==============================================================================

# 1. Licenciamento do Fornecedor (Obrigatório)
# Chave fornecida pela Central após a contratação do plano
LICENSE_KEY=UD-PROD-UNIFACULDADE-2026-ACTIVE
CENTRAL_API_URL=https://central.unidesk.com.br

# 2. Rede e Portas
PORT=3000
HOST_PORT=80

# 3. Informações da Instituição (Branding Padrão)
VITE_INSTITUTION_NAME=Faculdade Metropolitana
VITE_PRIMARY_COLOR=#4f46e5

# 4. Modo de Banco de Dados
# Padrão: sqlite (banco relacional nativo rápido sem necessidade de banco externo)
# Para banco externo gerenciado na nuvem (AWS RDS, PostgreSQL), descomente abaixo:
# DATABASE_URL=postgresql://unidesk_user:senha_forte@rds-endpoint.amazonaws.com:5432/unidesk_db

# 5. Políticas de Backup Automático
BACKUP_RETENTION_DAYS=15
BACKUP_INTERVAL_HOURS=24
